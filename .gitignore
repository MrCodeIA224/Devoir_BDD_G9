# Ignorer tout le contenu à l'intérieur des dossiers de données
data/config1/*
data/config2/*
data/config3/*
data/shard1/*
data/shard2/*
data/shard3/*
data/shard4/*

# Ne pas ignorer les fichiers .gitkeep pour conserver l'arborescence sur GitHub
!**/\.gitkeep

# Ignorer les journaux d'erreurs
*.log
dataset/
dataset_50000/
dataset_10000/

# Donnees des nouveaux membres du shard 1 (ajout Partie C)
data/shard1-node2/*
data/shard1-node3/*
!**/.gitkeep

# Fichiers systeme macOS
.DS_Store
**/.DS_Store

certs/*

keyfile/mongo-cluster.key
